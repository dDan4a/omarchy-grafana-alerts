root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 150

[*.go]
indent_style = tab

[[shell]]
indent_style = space
indent_size = 2
switch_case_indent = true

[*.gd]
indent_style = tab

[addons/**]
gdscript_formatter_exclude = true
